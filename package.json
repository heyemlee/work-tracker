{
  "name": "outbox",
  "private": true,
  "version": "0.1.0",
  "description": "Job-application tracker for applying to one posting from several accounts, with an email-reading agent.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "dev": "vite",
    "dev:local": "VITE_DATA=local vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b && npm run typecheck -w extension",
    "lint": "eslint .",
    "test": "vitest run && npm test -w extension",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply outbox --local",
    "db:migrate:remote": "wrangler d1 migrations apply outbox --remote",
    "auth:schema": "npx --yes auth@1.7.5 generate --config scripts/auth-schema.config.ts --output worker/db/auth-schema.ts --yes",
    "ext:dev": "npm run dev -w extension",
    "ext:build": "npm run build -w extension"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.103.2",
    "better-auth": "^1.7.5",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.9",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.2",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
