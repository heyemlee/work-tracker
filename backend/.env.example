DATABASE_URL=postgresql://outbox:outbox@localhost:55432/outbox
PORT=3100
# Syncs the followed boards once a day, checking every hour whether a day has passed.
ENABLE_SYNC=false

# Serves the deployed app through a Cloudflare Tunnel on 127.0.0.1:3101; the Worker's TOOLS_TOKEN secret holds the
# same value (docs/deploy.md). Leave empty to keep the service on this computer only.
TOOLS_TOKEN=

# Local resume lab: text extraction works without AI. Leave disabled until ready for paid calls.
ENABLE_RESUME_AI=false
RESUME_PROVIDER=openai
RESUME_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
